generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DocumentStatus {
  uploaded
  processing
  extracted
  failed
}

enum ExtractionStatus {
  pending
  approved
  corrected
}

enum ReviewAction {
  approved
  corrected
}

model Document {
  id          String         @id @default(uuid()) @db.Uuid
  filename    String
  contentHash String         @unique @map("content_hash")
  rawText     String         @map("raw_text")
  status      DocumentStatus @default(uploaded)
  uploadedAt  DateTime       @default(now()) @map("uploaded_at")
  split       DatasetSplit?

  extractions  Extraction[]
  llmRuns      LlmRun[]
  expertLabels ExpertLabel[]

  @@map("documents")
}

model Extraction {
  id            String           @id @default(uuid()) @db.Uuid
  documentId    String           @map("document_id") @db.Uuid
  fieldName     String           @map("field_name")
  value         String
  sourceClause  String           @map("source_clause")
  startOffset   Int              @map("start_offset")
  endOffset     Int              @map("end_offset")
  confidence    Float?
  model         String
  promptVersion String           @map("prompt_version")
  status        ExtractionStatus @default(pending)

  document Document @relation(fields: [documentId], references: [id])
  reviews  Review[]

  @@unique([documentId, fieldName, promptVersion])
  @@map("extractions")
}

model Review {
  id           String       @id @default(uuid()) @db.Uuid
  extractionId String       @map("extraction_id") @db.Uuid
  action       ReviewAction
  oldValue     String?      @map("old_value")
  newValue     String?      @map("new_value")
  reviewer     String
  reviewedAt   DateTime     @default(now()) @map("reviewed_at")

  extraction Extraction @relation(fields: [extractionId], references: [id])

  @@map("reviews")
}

model LlmRun {
  id            String   @id @default(uuid()) @db.Uuid
  documentId    String   @map("document_id") @db.Uuid
  model         String
  promptVersion String   @map("prompt_version")
  inputTokens   Int      @default(0) @map("input_tokens")
  outputTokens  Int      @default(0) @map("output_tokens")
  cost          Decimal  @default(0) @db.Decimal(10, 6)
  latencyMs     Int      @map("latency_ms")
  success       Boolean
  error         String?
  createdAt     DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id])

  @@index([documentId])
  @@map("llm_runs")
}

enum DatasetSplit {
  dev
  heldout
}

model ExpertLabel {
  id          String @id @default(uuid()) @db.Uuid
  documentId  String @map("document_id") @db.Uuid
  fieldName   String @map("field_name")
  text        String
  startOffset Int    @map("start_offset")
  endOffset   Int    @map("end_offset")

  document Document @relation(fields: [documentId], references: [id])

  @@index([documentId, fieldName])
  @@map("expert_labels")
}
